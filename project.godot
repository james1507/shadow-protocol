config_version=5

[application]
config/name="Shadow Protocol: Blacksite Breach"
config/version="2.0.0"
run/main_scene="res://scenes/menus/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]
EventBus="*res://scripts/autoload/event_bus.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
SettingsManager="*res://scripts/autoload/settings_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"
window/stretch/aspect="keep"

[rendering]
renderer/rendering_method="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.043,0.078,0.129,1)

[layer_names]
2d_physics/layer_1="WORLD_SOLID"
2d_physics/layer_2="PLAYER"
2d_physics/layer_3="ENEMY"
2d_physics/layer_4="PLAYER_ATTACK"
2d_physics/layer_5="ENEMY_ATTACK"
2d_physics/layer_6="INTERACTABLE"
2d_physics/layer_7="SENSOR"
2d_physics/layer_8="PROJECTILE"

[input]
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
crouch={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194326)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
gadget={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
developer_overlay={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194334)]
}
reload_checkpoint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
attack={
